---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
type Slot = { name: string; room: string } | null;
type ClassRow = { break?: false; period: string; time: [string, string]; cells: Slot[] };
type BreakRow = { break: true; label: string };

const calc = { name: "Calculus (I)", room: "EE Building, Room 214" };
const mcuMon = { name: "Microprocessor Applications", room: "EE Building, Room 200" };
const mcuThu = { name: "Microprocessor Applications", room: "EE Building, Room 204" };
const lab = { name: "Electrical Engineering Lab", room: "EE Building, Room 210" };
const emcMon = { name: "Electromagnetic Compatibility", room: "EE Building, Room 209" };
const emcTue = { name: "Electromagnetic Compatibility", room: "EE Building, Room 201" };

const rows: Array<ClassRow | BreakRow> = [
  { period: "Period 1", time: ["08:10", "09:00"], cells: [calc, null, null, null, calc] },
  { period: "Period 2", time: ["09:10", "10:00"], cells: [calc, null, lab, null, null] },
  { period: "Period 3", time: ["10:10", "11:00"], cells: [mcuMon, emcTue, lab, mcuThu, null] },
  { period: "Period 4", time: ["11:10", "12:00"], cells: [mcuMon, emcTue, lab, mcuThu, null] },
  { break: true, label: "12:10 – 13:00" },
  { period: "Period 5", time: ["13:10", "14:00"], cells: [null, null, null, null, null] },
  { period: "Period 6", time: ["14:10", "15:00"], cells: [emcMon, null, null, null, null] },
];

const courses = [
  {
    name: "Calculus (I)",
    items: [
      "Monday, Period 1, EE Building, Room 214",
      "Monday, Period 2, EE Building, Room 214",
      "Friday, Period 1, EE Building, Room 214",
    ],
  },
  {
    name: "Microprocessor Applications",
    items: [
      "Monday, Period 3, EE Building, Room 200",
      "Monday, Period 4, EE Building, Room 200",
      "Thursday, Period 3, EE Building, Room 204",
      "Thursday, Period 4, EE Building, Room 204",
    ],
  },
  {
    name: "Electrical Engineering Lab",
    items: [
      "Wednesday, Period 2, EE Building, Room 210",
      "Wednesday, Period 3, EE Building, Room 210",
      "Wednesday, Period 4, EE Building, Room 210",
    ],
  },
  {
    name: "Electromagnetic Compatibility",
    items: [
      "Monday, Period 6, EE Building, Room 209",
      "Tuesday, Period 3, EE Building, Room 201",
      "Tuesday, Period 4, EE Building, Room 201",
    ],
  },
];
---
<BaseLayout title="AIoTCA LAB - Class-Schedule">
  <div class="schedule" id="content">
    <h1><span style="color: var(--accent)">Prof. Dr. Wei Chien</span> Teaching Timetable</h1>
    <p class="caption">Academic Timetable</p>
    <table>
      <thead>
        <tr>
          <th>Period</th>
          {days.map((d) => <th>{d}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) =>
          row.break ? (
            <tr>
              <td class="time">Lunch</td>
              <td class="break" colspan="5">{row.label}</td>
            </tr>
          ) : (
            <tr>
              <td class="time">
                {row.period}<br />
                {row.time[0]}–{row.time[1]}
              </td>
              {row.cells.map((cell) => (
                <td>
                  {cell && (
                    <div class="slot">
                      <b>{cell.name}</b>
                      {cell.room}
                    </div>
                  )}
                </td>
              ))}
            </tr>
          )
        )}
      </tbody>
    </table>

    <div class="course-list">
      {courses.map((course) => (
        <section>
          <h2>{course.name}</h2>
          <ul>
            {course.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
